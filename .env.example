# ==============================================================================
# FocusGram - Build & Environment Template
# ==============================================================================
# Instructions:
# 1. Copy this template file to '.env' in the project root:
#      cp .env.example .env
# 2. Fill in your local configuration values in '.env'.
# 3. Never commit '.env' to version control (it is ignored by .gitignore).
# ==============================================================================

# --- Android Release Signing & Keystore Configuration ---
# What: Path to the Android release signing keystore file
# Where: Generated with keytool or Android Studio Build > Generate Signed Bundle / APK
# Required: Optional for debug builds; required for signing release APKs
# Example: upload-keystore.jks or /absolute/path/to/keystore.jks
KEYSTORE_PATH=upload-keystore.jks

# What: Password for the release keystore file
# Where: Set during keystore creation
# Required: Required if KEYSTORE_PATH is configured
# Example: your_keystore_password_here
KEYSTORE_PASSWORD=your_keystore_password_here

# What: Key alias inside the keystore
# Where: Defined during keystore creation
# Required: Required if KEYSTORE_PATH is configured
# Example: upload
KEY_ALIAS=upload

# What: Password for the specific key alias
# Where: Set during keystore creation
# Required: Required if KEYSTORE_PATH is configured
# Example: your_key_password_here
KEY_PASSWORD=your_key_password_here

# --- GeckoView Mozilla Browser Engine Settings ---
# What: GeckoView distribution channel
# Where: Mozilla Maven repository (omni, release, beta, nightly)
# Required: Optional (defaults to omni)
# Example: omni
GECKOVIEW_CHANNEL=omni

# What: Specific GeckoView build version
# Where: Mozilla Maven Central or FocusGram dependency declarations
# Required: Optional (defaults to pinned version)
# Example: 157.0.20260924084938
GECKOVIEW_VERSION=157.0.20260924084938

# --- Android SDK & Build Target Configuration ---
# What: Android SDK compile version
# Where: Android SDK Manager
# Required: Optional (defaults to 35)
# Example: 35
COMPILE_SDK_VERSION=35

# What: Minimum Android API level supported
# Where: Android developer documentation
# Required: Optional (defaults to 26 for Android 8.0+)
# Example: 26
MIN_SDK_VERSION=26

# What: Target Android API level
# Where: Android developer documentation
# Required: Optional (defaults to 35)
# Example: 35
TARGET_SDK_VERSION=35

# --- Local Diagnostics & Development Flags ---
# What: Exposes GeckoView remote debugging socket for Firefox DevTools (about:debugging)
# Where: Development flag (true / false)
# Required: Optional (defaults to false)
# Example: false
ENABLE_GECKOVIEW_DEBUG_PORT=false

# What: StrictMode enforcement for threading and disk IO checks in debug builds
# Where: Development flag (true / false)
# Required: Optional (defaults to false)
# Example: false
ENABLE_STRICT_MODE=false

# --- Rewarded Ad Configuration (Isolated Container) ---
# What: Primary host domain for the voluntary support rewarded ad container
# Where: Adsterra publisher dashboard
# Required: Optional
# Example: effectivecpmnetwork.com
ADSTERRA_DOMAIN_PRIMARY=effectivecpmnetwork.com

# What: Secondary fallback host domain for the voluntary support rewarded ad container
# Where: Adsterra publisher dashboard
# Required: Optional
# Example: highperformanceformat.com
ADSTERRA_DOMAIN_SECONDARY=highperformanceformat.com
