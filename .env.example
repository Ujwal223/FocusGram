# ==============================================================================
# FocusGram — Master Build & Release Environment Template
# ==============================================================================
# INSTRUCTIONS FOR DEVELOPER (Ujwal):
# 1. Copy this file to '.env' in the project root:
#      cp .env.example .env
# 2. Fill in your local values in '.env'.
# 3. NEVER commit '.env' to version control (already in .gitignore).
# 4. AGENTS RULE: Agents are strictly prohibited from viewing or editing '.env'.
#    Agents may only inspect or update '.env.example'.
# ==============================================================================

# --- Android Release Signing & Keystore Configuration ---
# Path to your upload keystore file (relative or absolute)
KEYSTORE_PATH=upload-keystore.jks
KEYSTORE_PASSWORD=your_keystore_password_here
KEY_ALIAS=upload
KEY_PASSWORD=your_key_password_here

# --- GeckoView Mozilla Browser Engine Settings ---
# Mozilla channel: omni (default recommended), release, beta, or nightly
GECKOVIEW_CHANNEL=omni
# Specific GeckoView build version
GECKOVIEW_VERSION=157.0.20260924084938

# --- Android SDK & Build Target Configuration (CachyOS / Linux) ---
COMPILE_SDK_VERSION=35
MIN_SDK_VERSION=26
TARGET_SDK_VERSION=35

# --- Local Diagnostics & Development Flags ---
# Set to true to expose remote debugging port (about:debugging in Firefox)
ENABLE_GECKOVIEW_DEBUG_PORT=false
# StrictMode enforcement for threading and disk IO checks
ENABLE_STRICT_MODE=false

# --- Rewarded Ad Configuration (Isolated Container) ---
# Adsterra ad slot domains (Strictly isolated from main Instagram session)
ADSTERRA_DOMAIN_PRIMARY=effectivecpmnetwork.com
ADSTERRA_DOMAIN_SECONDARY=highperformanceformat.com
