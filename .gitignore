.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
*.bak
*.class
*.pyc

# IDEs
.idea/
*.iml
*.ipr
*.iws
.vscode/
.atom/
.history
.svn/
.navigation/

# ------------------------------------------------------------------------------
