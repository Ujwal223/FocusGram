.gradle/
**/.gradle/
.kotlin/
**/.kotlin/
.android/
**/.android/
gradle-app.setting
!gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.jar

# Machine-specific SDK & local configurations
local.properties
**/local.properties

# Build directories & outputs
build/
**/build/
app/build/
*.apk
*.aab
*.ap_
*.dex
captures/
.cxx/
**/cxx/

# Profiling & Diagnostics
*.hprof
*.log
.buildlog/

# ------------------------------------------------------------------------------
# 4. Multi-Agent Governance & Documentation (Keep untracked from Git if needed)
# ------------------------------------------------------------------------------
.agents/
system/
Documents/
